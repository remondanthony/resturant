{
  "name": "tavolo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.mts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.mts",
    "db:studio": "node --env-file=.env.local ./node_modules/.bin/drizzle-kit studio",
    "staff:add": "tsx --env-file=.env.local scripts/create-staff.mts",
    "setup": "npm run db:migrate && npm run db:seed",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "tsx --conditions=react-server --env-file=.env.local tests/integration.mts",
    "db:start": "/usr/local/opt/postgresql@17/bin/pg_ctl -D /usr/local/var/postgresql@17 -l /usr/local/var/log/postgresql@17.log start",
    "db:stop": "/usr/local/opt/postgresql@17/bin/pg_ctl -D /usr/local/var/postgresql@17 stop -m fast"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
